---
import Temel from '../layouts/Temel.astro';
import OlayKarti from '../components/OlayKarti.astro';
import Ikon from '../components/Ikon.astro';
import { reader, paragraflar } from '../lib/icerik';

const s = (await reader.singletons.anasayfa.read())!;
const ok = `<svg class="ok" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>`;
const [siniflandirma, dlp, yz] = s.moduller;
---
<Temel baslik={s.seoBaslik} aciklama={s.seoAciklama}>
  <!-- 01 · Üst bölüm -->
  <section class="hero">
    <div class="wrap hero__ic">
      <div class="hero__metin">
        <p class="eyebrow">{s.eyebrow}</p>
        <h1 class="display hero__baslik">{s.baslik}</h1>
        <p class="lead">{s.ozet}</p>
        <div class="sayfa-basi__eylem">
          {/* Kılavuz: görünümde tek petrol düğme var (üst menüdeki "Demo isteyin"); hero'da ikincil düğmeler */}
          <a class="btn hero__beyaz" href={s.ikincilCta.url}>{s.ikincilCta.etiket}<Fragment set:html={ok} /></a>
          <a class="btn btn--ters" href={s.birincilCta.url}>{s.birincilCta.etiket}</a>
        </div>
        <ul class="hero__olgular">
          <li><Ikon ad="kurum" boyut={18} />Türkiye'de geliştirildi</li>
          <li><Ikon ad="sunucu" boyut={18} />Yerinde (on-prem) kurulum</li>
          <li><Ikon ad="liste" boyut={18} />TCKN, IBAN, VKN hazır gelir</li>
        </ul>
      </div>
      <div class="hero__gorsel hazir">
        <noscript><style>.hero__gorsel.hazir *{opacity:1!important;transform:none!important;visibility:visible!important;stroke-dashoffset:0!important}</style></noscript>
        <span class="m-blok b-petrol hb1" aria-hidden="true"></span>
        <span class="m-blok b-petrol-acik hb2" aria-hidden="true"></span>
        <span class="m-blok b-lacivert hb3" aria-hidden="true"></span>
        <span class="m-blok b-petrol-koyu hb4" aria-hidden="true"></span>
        <div class="hero__kart">
        <OlayKarti
          ust={s.olay.kategori}
          cumle={s.olay.cumle}
          satirlar={[
            { ad: 'Dosya', deger: s.olay.dosya },
            { ad: 'İçerik', deger: s.olay.icerik },
            { ad: 'Hedef', deger: s.olay.hedef },
          ]}
          karar={s.olay.karar}
          mesaj={s.olay.kullaniciMesaji}
          canli
        />
        </div>
      </div>
    </div>
  </section>

  <!-- 02 · Kanallar -->
  <section class="bolum" aria-labelledby="kanal-baslik">
    <div class="wrap">
      <div class="bolum-baslik">
        <p class="eyebrow">01 · Tek politika</p>
        <h2 id="kanal-baslik" class="h1">{s.kanalBaslik}</h2>
        <p class="lead">{s.kanalAciklama}</p>
      </div>
      <div class="kanal" data-sekmeler>
        <div class="kanal__sekmeler" role="tablist" aria-label="Kanallar">
          {s.kanallar.map((k, i) => (
            <button role="tab" type="button" id={`sekme-${i}`} aria-controls={`kanal-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
              <span class="mono">{String(i + 1).padStart(2, '0')}</span>{k.ad}
            </button>
          ))}
        </div>
        {s.kanallar.map((k, i) => (
          <div class="kanal__panel" role="tabpanel" id={`kanal-${i}`} aria-labelledby={`sekme-${i}`} hidden={i !== 0}>
            <div class="maske">
              <div><span class="mono muted">Kullanıcının gönderdiği</span><pre>{k.once}</pre></div>
              <div class="maske__ok"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" role="img" aria-label="Korvia politikası"><path d="M4 10h12M11 5l5 5-5 5" /></svg></div>
              <div>
                <span class="mono muted">Kurumdan çıkan · {k.hedef}</span>
                <pre set:html={k.sonra.replace(/(\S*\*+\S*)/g, '<mark>$1</mark>')} />
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 03 · İlkeler -->
  <section class="bolum bolum--beyaz" aria-labelledby="ilke-baslik">
    <div class="wrap">
      <div class="bolum-baslik">
        <p class="eyebrow">02 · Bağlam</p>
        <h2 id="ilke-baslik" class="h1">{s.ilkeBaslik}</h2>
        <p class="lead">{s.ilkeAciklama}</p>
      </div>
      <ol class="adimlar adimlar--3">
        {s.ilkeler.map((o) => (<li><h3 class="h3">{o.baslik}</h3><p>{o.metin}</p></li>))}
      </ol>
    </div>
  </section>

  <!-- 04 · Modüller -->
  <section class="bolum" aria-labelledby="mod-1">
    <div class="wrap modul">
      <div class="modul__metin">
        <p class="eyebrow">03 · {siniflandirma.eyebrow}</p>
        <h2 id="mod-1" class="h1">{siniflandirma.baslik}</h2>
        <p class="lead">{siniflandirma.metin}</p>
        <a class="metin-link" href={siniflandirma.link.url}>{siniflandirma.link.etiket}<Fragment set:html={ok} /></a>
      </div>
      <figure class="dosya" aria-label="Örnek sınıflandırılmış dosya">
        <div class="dosya__ust">
          <span class="mono">{siniflandirma.maddeler[0]}</span>
          <span class="etiket etiket--gizli">{siniflandirma.maddeler[siniflandirma.maddeler.length - 1]}</span>
        </div>
        <p class="dosya__metin">Bu sözleşme 24 ay boyunca birim fiyatı <mark>₺412,50</mark> olarak belirler ve ödemeler aşağıdaki hesaba yapılır: <mark>TR33 0006 1005 1978 6457 8413 26</mark>…</p>
        <figcaption class="dosya__etiketler">
          {siniflandirma.maddeler.slice(1, -1).map((m) => <span class="etiket">{m}</span>)}
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="bolum bolum--beyaz" aria-labelledby="mod-2">
    <div class="wrap modul modul--ters">
      <div class="modul__metin">
        <p class="eyebrow">04 · {dlp.eyebrow}</p>
        <h2 id="mod-2" class="h1">{dlp.baslik}</h2>
        <p class="lead">{dlp.metin}</p>
        <a class="metin-link" href={dlp.link.url}>{dlp.link.etiket}<Fragment set:html={ok} /></a>
      </div>
      <div>
        <div class="olcek">
          <div><strong>İzle</strong><p>görün</p></div>
          <div><strong>Uyar</strong><p>kullanıcıya söyleyin</p></div>
          <div><strong>Kaydet</strong><p>kanıtı saklayın</p></div>
          <div><strong>Engelle</strong><p>durdurun</p></div>
        </div>
        <div class="olcek__eksen mono"><span>düşük müdahale</span><span>yüksek müdahale</span></div>
      </div>
    </div>
  </section>

  <section class="bolum" aria-labelledby="kapi-baslik">
    <div class="wrap iki-sutun">
      <h2 id="kapi-baslik" class="h1">{s.kapiBaslik}</h2>
      <div>
        <div class="prose">{paragraflar(s.kapiMetin).map((p) => <p>{p}</p>)}</div>
        <ul class="kapilar">
          {[['usb','USB bellek'],['yazdir','Yazdırma'],['pano','Pano'],['eposta','E-posta'],['web','Web yükleme'],['bulut','Bulut uygulaması'],['yapayZeka','Yapay zekâ komutu'],['kod','Kod asistanı']].map(([i, a], n) => (
            <li style={`--i:${n}`}><span class="kapilar__ikon"><Ikon ad={i} boyut={20} /></span><span>{a}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="bolum bolum--beyaz" aria-labelledby="mod-3">
    <div class="wrap modul">
      <div class="modul__metin">
        <p class="eyebrow">05 · {yz.eyebrow}</p>
        <h2 id="mod-3" class="h1">{yz.baslik}</h2>
        <p class="lead">{yz.metin}</p>
        <a class="metin-link" href={yz.link.url}>{yz.link.etiket}<Fragment set:html={ok} /></a>
      </div>
      <div class="terminal" role="img" aria-label="Kod asistanında engellenen bir komutun örneği">
        <div class="terminal__ust"><span></span><span></span><span></span><b>odeme-api · claude</b></div>
        <pre><span class="t-soluk">&gt;</span> bağlantı hatasını düzelt, config/prod.env dosyasına bak
<span class="t-soluk">  okunuyor: config/prod.env</span>
<span class="t-kirmizi">■ korvia</span> Gönderilmedi. Dosyada canlı bir API anahtarı var
  (STRIPE_SECRET_KEY, satır 4). Anahtarı kaldırıp tekrar deneyin
  veya istisna isteyin.  <span class="t-soluk">politika: gizli-anahtar · karar: engelle</span></pre>
      </div>
    </div>
  </section>

  <!-- 05 · Kurulum -->
  <section class="bolum" aria-labelledby="dagitim-baslik">
    <div class="wrap">
      <div class="bolum-baslik">
        <p class="eyebrow">06 · Kurulum</p>
        <h2 id="dagitim-baslik" class="h1">{s.dagitimBaslik}</h2>
        <p class="lead">{s.dagitimMetin}</p>
      </div>
      <div class="dagitim">
        {s.dagitimSecenekleri.map((o, i) => (
          <div class="dagitim__oge">
            <span class="mono muted">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="h3">{o.baslik}</h3>
            <p>{o.metin}</p>
          </div>
        ))}
      </div>
      <p class="vurgu" style="margin-top:40px">
        <strong>{s.pocNot}</strong>
        <a class="metin-link" href="/kaynaklar/poc-rehberi/">POC planlayın<Fragment set:html={ok} /></a>
      </p>
    </div>
  </section>
</Temel>

<script>
  document.querySelectorAll<HTMLElement>('.kapilar').forEach((kap) => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const kutular = Array.from(kap.querySelectorAll<HTMLElement>('li'));
    let son = -1, zaman: number | undefined;
    const yak = () => {
      let i = Math.floor(Math.random() * kutular.length);
      if (i === son) i = (i + 1 + Math.floor(Math.random() * (kutular.length - 1))) % kutular.length;
      son = i;
      const k = kutular[i];
      k.classList.add('yanik');
      setTimeout(() => k.classList.remove('yanik'), 1400);
    };
    new IntersectionObserver(([g]) => {
      if (g.isIntersecting && !zaman) { yak(); zaman = window.setInterval(yak, 900); }
      else if (!g.isIntersecting && zaman) { clearInterval(zaman); zaman = undefined; }
    }, { threshold: 0.15 }).observe(kap);
  });
</script>

<style>
  /* Kılavuz örneği: lacivert zemin, beyaz logo, kilitlenen bloklar */
  .hero { background: var(--inverse); color: #fff; overflow: hidden; }
  .hero__ic { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: clamp(32px, 5vw, 64px); padding-top: clamp(48px, 7vw, 88px); padding-bottom: clamp(48px, 7vw, 88px); align-items: center; }
  .hero__metin { display: grid; gap: 22px; }
  .hero__metin .eyebrow { color: var(--brand-light); font-size: clamp(13px, 1.1vw, 15px); line-height: 1.4; letter-spacing: 0.1em; }
  .hero__baslik { font-size: clamp(34px, 4.3vw, 46px); line-height: 1.1; }
  .hero__metin h1 { color: #fff; }
  .hero__metin .lead { max-width: 54ch; color: var(--l-200); }
  .hero__beyaz { background: #fff; color: var(--ink); }
  .hero__beyaz:hover { background: var(--l-50); }
  .hero__olgular { list-style: none; margin: 8px 0 0; padding: 20px 0 0; border-top: 1px solid var(--l-600); display: flex; flex-wrap: wrap; gap: 10px 28px; color: var(--l-100); font-size: 14px; font-weight: 500; }
  .hero__olgular li { display: flex; align-items: center; gap: 8px; }
  .hero__olgular :global(.ikon) { color: var(--brand-light); }

  /* Bloklar 8 px boşlukla yaslanır, üst üste binmez */
  .hero__gorsel { display: grid; gap: 8px; grid-template-columns: 56px minmax(0, 1fr) 44px; grid-template-rows: 1fr 1fr 1fr; min-height: 470px; }
  .m-blok { display: block; border-radius: var(--r-xl); }
  .hb1 { grid-column: 1; grid-row: 1 / span 2; }
  .hb2 { grid-column: 1; grid-row: 3; }
  .hb3 { grid-column: 3; grid-row: 1; }
  .hb4 { grid-column: 3; grid-row: 2 / span 2; }
  .hero__kart { grid-column: 2; grid-row: 1 / span 3; align-self: center; }
  .hero__kart :global(.olay) { border-radius: var(--r-xl); border-color: transparent; }
  @media (max-width: 560px) { .hero__gorsel { grid-template-columns: 1fr; grid-template-rows: auto; min-height: 0; } .m-blok { display: none; } .hero__kart { grid-column: 1; grid-row: 1; } }

  /* ---- Üst bölüm canlandırması ----
     Sıra: üç kare sırayla yanar → çizgi uzar → kart satırları daktilo gibi yazılır
     → "inceleniyor..." → Engelle rozeti → kullanıcı uyarısı. Yerleşim kaymaz:
     metin baştan yerinde durur, harfler yalnızca görünür hâle gelir. */
  /* Bloklar sırayla yerine oturur, sonra kart yazılır */
  .hero__gorsel.hazir .m-blok { opacity: 0; transform: scale(.85); }
  .hero__gorsel.oynat .m-blok { animation: blokOtur 520ms cubic-bezier(.2,0,0,1) forwards; }
  .hero__gorsel.oynat .hb3 { animation-delay: 220ms; }
  .hero__gorsel.oynat .hb4 { animation-delay: 440ms; }
  .hero__gorsel.oynat .hb2 { animation-delay: 660ms; }
  @keyframes blokOtur { 0% { opacity: 0; transform: scale(.85); } 100% { opacity: 1; transform: scale(1); } }

  .hero__gorsel.hazir :global([data-yaz]:not(.bolundu)) { visibility: hidden; }
  .hero__gorsel :global(.h) { opacity: 0; }
  .hero__gorsel :global(.h.g) { opacity: 1; }
  .hero__gorsel :global(.h.son) { position: relative; }
  .hero__gorsel :global(.h.son::after) {
    content: ''; display: inline-block; width: 2px; height: 1.05em; margin-left: 1px; vertical-align: -0.15em;
    background: var(--brand); animation: imlec 700ms steps(1) infinite;
    position: absolute; right: -3px; top: 0.12em; margin: 0;
  }
  @keyframes imlec { 50% { opacity: 0; } }

  .hero__gorsel :global(.olay__bekle) { display: none; color: var(--text-muted); font-size: 13px; }
  .hero__gorsel.hazir :global([data-karar]) { opacity: 0; transform: scale(.6); }
  .hero__gorsel.hazir :global([data-mesaj]) { opacity: 0; transform: translateY(8px); }
  .hero__gorsel.bekle :global(.olay__bekle) { display: inline; }
  .hero__gorsel.bekle :global(.olay__bekle i) { font-style: normal; animation: nokta 900ms infinite; }
  .hero__gorsel.bekle :global(.olay__bekle i:nth-child(2)) { animation-delay: 150ms; }
  .hero__gorsel.bekle :global(.olay__bekle i:nth-child(3)) { animation-delay: 300ms; }
  @keyframes nokta { 0%, 100% { opacity: .2; } 50% { opacity: 1; } }
  .hero__gorsel.sonuc :global([data-karar]) { animation: rozet 520ms cubic-bezier(.2,.9,.3,1.3) forwards; }
  .hero__gorsel.sonuc :global(.olay) { animation: kartTit 380ms 120ms ease-out; }
  .hero__gorsel.uyari :global([data-mesaj]) { transition: opacity 420ms ease, transform 420ms cubic-bezier(.2,0,0,1); opacity: 1; transform: none; }
  @keyframes rozet { 0% { opacity: 0; transform: scale(.6); } 70% { opacity: 1; transform: scale(1.12); } 100% { opacity: 1; transform: scale(1); } }
  @keyframes kartTit { 0%, 100% { box-shadow: 0 0 0 0 rgba(180,47,55,0); } 40% { box-shadow: 0 0 0 4px rgba(240,138,143,.55); } }

  @media (prefers-reduced-motion: reduce) {
    .hero__gorsel .m-blok, .hero__gorsel :global(.h), .hero__gorsel :global([data-karar]), .hero__gorsel :global([data-mesaj]) { opacity: 1 !important; transform: none !important; stroke-dashoffset: 0 !important; animation: none !important; }
  }
  @media (max-width: 960px) { .hero__ic { grid-template-columns: 1fr; } }

  .kanal__sekmeler { display: flex; gap: 0; border-bottom: 1px solid var(--line-strong); margin-bottom: 20px; overflow-x: auto; }
  .kanal__sekmeler button {
    display: inline-flex; gap: 10px; align-items: center; min-height: 48px; padding: 0 18px;
    background: none; border: 0; border-bottom: 2px solid transparent; margin-bottom: -1px;
    font: 600 15px/1 var(--f-body); color: var(--ink-muted); cursor: pointer; white-space: nowrap;
  }
  .kanal__sekmeler button .mono { font-size: 12px; color: var(--n-400); }
  .kanal__sekmeler button[aria-selected='true'] { color: var(--ink); border-bottom-color: var(--brand); }
  .kanal__sekmeler button:hover { color: var(--ink); }

  .modul { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(32px, 6vw, 88px); align-items: center; }
  .modul--ters > :first-child { order: 2; }
  .modul__metin { display: grid; gap: 18px; justify-items: start; }
  @media (max-width: 900px) { .modul { grid-template-columns: 1fr; } .modul--ters > :first-child { order: 0; } }

  .kapilar { list-style: none; margin: 28px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: var(--r-lg); overflow: hidden; }
  .kapilar li { background: var(--surface); display: grid; gap: 10px; padding: 16px; font-size: 14px; line-height: 20px; color: var(--ink-muted); justify-items: start; }
  .kapilar li :global(.ikon) { color: var(--ink); }

  /* Rastgele yanan kutucuklar: JS her ~0,9 sn'de bir kutuya .yanik ekler */
  .kapilar__ikon { display: inline-grid; place-items: center; width: 40px; height: 40px; border-radius: var(--r-md); background: var(--surface-alt); }
  .kapilar li, .kapilar__ikon, .kapilar__ikon :global(.ikon) { transition: background-color 500ms var(--ease), color 500ms var(--ease); }
  .kapilar li.yanik, .kapilar li:hover { background: var(--brand-soft); color: var(--ink); }
  .kapilar li.yanik .kapilar__ikon, .kapilar li:hover .kapilar__ikon { background: var(--brand); }
  .kapilar li.yanik .kapilar__ikon :global(.ikon), .kapilar li:hover .kapilar__ikon :global(.ikon) { color: #fff; }
  @media (max-width: 560px) { .kapilar { grid-template-columns: repeat(2, 1fr); } }
  .dosya { margin: 0; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); padding: 24px; display: grid; gap: 18px; }
  .dosya__ust { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding-bottom: 16px; border-bottom: 1px solid var(--line); }
  .dosya__metin { font-size: 15px; line-height: 25px; color: var(--ink-muted); }
  .dosya mark { background: var(--p-100); color: var(--brand-active); padding: 0 3px; border-radius: 2px; }
  .dosya__etiketler { display: flex; flex-wrap: wrap; gap: 8px; }
  .etiket { font: 600 13px/1 var(--f-body); padding: 7px 10px; border-radius: var(--r-sm); background: var(--brand-soft); color: var(--brand-text); }
  .etiket--gizli { background: var(--inverse); color: #fff; }

  .terminal { background: var(--ink); border-radius: var(--r-lg); overflow: hidden; color: #f2eeee; }
  .terminal__ust { display: flex; align-items: center; gap: 6px; padding: 12px 16px; border-bottom: 1px solid var(--ink-muted); }
  .terminal__ust span { width: 10px; height: 10px; border-radius: 50%; background: var(--ink-subtle); }
  .terminal__ust b { margin-left: 10px; font: 500 12px/1 var(--f-mono); color: var(--n-300); }
  .terminal pre { margin: 0; padding: 20px; font: 500 13.5px/23px var(--f-mono); white-space: pre-wrap; }
  .t-soluk { color: var(--n-300); }
  .t-kirmizi { color: var(--brand-light); font-weight: 700; }

  .dagitim { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 2px solid var(--ink); }
  .dagitim__oge { padding: 20px 24px 0 0; display: grid; gap: 8px; align-content: start; }
  .dagitim__oge + .dagitim__oge { padding-left: 24px; border-left: 1px solid var(--line); }
  .dagitim__oge p { color: var(--ink-muted); }
  @media (max-width: 760px) { .dagitim { grid-template-columns: 1fr; } .dagitim__oge + .dagitim__oge { padding-left: 0; border-left: 0; border-top: 1px solid var(--line); } .dagitim__oge { padding-bottom: 16px; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-sekmeler]').forEach((kap) => {
    const sekmeler = Array.from(kap.querySelectorAll<HTMLButtonElement>('[role=tab]'));
    const sec = (s: HTMLButtonElement, odak = false) => {
      sekmeler.forEach((x) => {
        const aktif = x === s;
        x.setAttribute('aria-selected', String(aktif));
        x.tabIndex = aktif ? 0 : -1;
        document.getElementById(x.getAttribute('aria-controls')!)!.hidden = !aktif;
      });
      if (odak) s.focus();
    };
    sekmeler.forEach((s, i) => {
      s.addEventListener('click', () => sec(s));
      s.addEventListener('keydown', (e) => {
        const n = sekmeler.length;
        if (e.key === 'ArrowRight') sec(sekmeler[(i + 1) % n], true);
        else if (e.key === 'ArrowLeft') sec(sekmeler[(i - 1 + n) % n], true);
        else if (e.key === 'Home') sec(sekmeler[0], true);
        else if (e.key === 'End') sec(sekmeler[n - 1], true);
        else return;
        e.preventDefault();
      });
    });
  });
</script>

<script>
  // Üst bölümdeki olay kartı canlandırması (ekrana girince oynar, çıkıp geri gelince tekrar oynar)
  const kap = document.querySelector<HTMLElement>('.hero__gorsel');
  const azHareket = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (kap && azHareket) kap.classList.remove('hazir');
  if (kap && !azHareket) {
    const yazilar = Array.from(kap.querySelectorAll<HTMLElement>('[data-yaz]'));
    // Her harfi ayrı span'a böl: metin baştan yerinde, yerleşim kaymaz.
    yazilar.forEach((el) => {
      const metin = el.textContent ?? '';
      el.setAttribute('aria-label', metin);
      el.textContent = '';
      for (const ch of metin) {
        const s = document.createElement('span');
        s.className = 'h';
        s.setAttribute('aria-hidden', 'true');
        s.textContent = ch;
        el.appendChild(s);
      }
      el.classList.add('bolundu');
    });
    const bekle = (ms: number) => new Promise((r) => setTimeout(r, ms));
    let calisiyor = 0;
    const oynat = async () => {
      const no = ++calisiyor;
      const iptal = () => no !== calisiyor;
      kap.classList.remove('oynat', 'bekle', 'sonuc', 'uyari');
      kap.classList.add('hazir');
      kap.querySelectorAll('.h').forEach((h) => h.classList.remove('g', 'son'));
      void kap.offsetWidth;
      kap.classList.add('oynat');
      await bekle(1300);
      for (const el of yazilar) {
        if (iptal()) return;
        const harfler = Array.from(el.querySelectorAll<HTMLElement>('.h'));
        const hiz = el.classList.contains('mono') ? 12 : 20;
        let onceki: HTMLElement | null = null;
        for (const h of harfler) {
          if (iptal()) return;
          onceki?.classList.remove('son');
          h.classList.add('g', 'son');
          onceki = h;
          await bekle(h.textContent === ' ' ? hiz / 2 : hiz + Math.random() * 14);
        }
        await bekle(220);
        onceki?.classList.remove('son');
      }
      if (iptal()) return;
      kap.classList.add('bekle');
      await bekle(1100);
      if (iptal()) return;
      kap.classList.remove('bekle');
      kap.classList.add('sonuc');
      await bekle(650);
      if (iptal()) return;
      kap.classList.add('uyari');
    };
    let gorunuyor = false;
    new IntersectionObserver((girdiler) => {
      const g = girdiler[0].isIntersecting;
      if (g && !gorunuyor) oynat();
      if (!g) calisiyor++;
      gorunuyor = g;
    }, { threshold: 0.15 }).observe(kap);
  }
</script>
