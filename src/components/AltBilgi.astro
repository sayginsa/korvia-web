---
import { menu, ayarlar } from '../lib/icerik';
const a = await ayarlar();
const b = await menu();
const bul = (k: string) => b.find((x) => x.anahtar === k)!;
const sutunlar = [
  { ad: 'Platform', ogeler: bul('platform').gruplar[0].ogeler },
  { ad: 'Yapay zekâ ve çözümler', ogeler: [...bul('yapay-zeka').gruplar[0].ogeler, ...bul('cozumler').gruplar[0].ogeler] },
  { ad: 'Sektörler', ogeler: bul('cozumler').gruplar[1].ogeler },
  { ad: 'Kaynaklar ve kurumsal', ogeler: [...bul('kaynaklar').gruplar[0].ogeler, ...bul('kurumsal').gruplar[0].ogeler] },
];
const yil = new Date().getFullYear();
---
<footer class="alt">
  <div class="wrap">
    <div class="alt__ust">
      <div>
        <img src="/logo/korvia-yatay-koyu-zemin.svg" alt="korvia" width="144" height="32" style="height:32px;width:auto" />
        <p>{a.footerMetni}</p>
        <p style="margin-top:20px"><a href={`mailto:${a.satisEposta}`}>{a.satisEposta}</a><br />{a.telefon}</p>
      </div>
      <div class="alt__sutunlar">
        {sutunlar.map((s) => (
          <nav aria-label={s.ad}>
            <h2>{s.ad}</h2>
            <ul>{s.ogeler.map((o) => <li><a href={o.url}>{o.ad}</a></li>)}</ul>
          </nav>
        ))}
      </div>
    </div>
    <div class="alt__alt">
      <span>© {yil} {a.sirketAdi} · Korvia</span>
      <ul>
        <li><a href="/kvkk-aydinlatma/">KVKK aydınlatma metni</a></li>
        <li><a href="/cerezler/">Çerezler</a></li>
      </ul>
    </div>
  </div>
</footer>
